# LiveKit Cloud project credentials — get from https://cloud.livekit.io/
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# STT — Deepgram (https://console.deepgram.com/)
DEEPGRAM_API_KEY=

# LLM — Baseten (OpenAI-compatible endpoint). Grab your API key + endpoint from Baseten dashboard.
# Baseten model deployments expose an OpenAI-compatible URL, e.g. https://model-xxx.api.baseten.co/environments/production/sync/v1
LLM_BASE_URL=https://inference.baseten.co/v1
LLM_API_KEY=
# Model identifier — defaults to GLM 4.5 Fast for lowest voice latency.
# Options you mentioned: "zai-org/GLM-4.5-Air", "moonshotai/Kimi-K2-Instruct", "deepseek-ai/DeepSeek-V3.1"
# Update to the exact model string Baseten exposes for your deployment.
LLM_MODEL=zai-org/GLM-4.5-Air

# TTS — ElevenLabs (voice provider only, NOT the agents platform)
ELEVENLABS_API_KEY=
# Rachel (default warm American voice). Swap voice_id for a different character.
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# Personalization API keys
# Ticketmaster Discovery API — https://developer.ticketmaster.com/
TICKETMASTER_API_KEY=
# Open-Meteo needs no API key.
